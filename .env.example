# Google AI Studio key (free tier, no credit card): https://aistudio.google.com/apikey
# Leave empty to run in DEMO MODE (canned detection/extraction/matching).
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_DETECT_MODEL=gemini-3.5-flash-lite

PORT=3000
RADIUS_KM=5

# Optional SMTP for really sending anonymous invite emails.
# Leave empty to preview emails in the UI instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
